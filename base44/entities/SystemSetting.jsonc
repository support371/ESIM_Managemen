{
  "name": "SystemSetting",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "value": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "general",
        "billing",
        "notification",
        "security",
        "integration"
      ],
      "default": "general"
    },
    "description": {
      "type": "string"
    }
  },
  "rls": {
    "create": { "user_condition": { "role": "super_admin" } },
    "read": true,
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "delete": { "user_condition": { "role": "super_admin" } }
  },
  "required": [
    "key",
    "value",
    "label"
  ]
}
