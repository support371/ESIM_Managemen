{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "ticketNumber": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "userEmail": {
      "type": "string",
      "format": "email"
    },
    "userName": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "activation",
        "billing",
        "technical",
        "account",
        "general",
        "other"
      ],
      "default": "general"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting",
        "resolved",
        "closed"
      ],
      "default": "open"
    },
    "assignedTo": {
      "type": "string"
    },
    "response": {
      "type": "string"
    }
  },
  "rls": {
    "create": { "user_condition": { "status": "active" } },
    "read": {
      "$or": [
        { "data.userEmail": "{{user.email}}" },
        { "data.userId": "{{user.id}}" },
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "agent" } },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "agent" } },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "delete": { "user_condition": { "role": "super_admin" } }
  },
  "required": [
    "userId",
    "userEmail",
    "subject",
    "message"
  ]
}
