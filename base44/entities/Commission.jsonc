{
  "name": "Commission",
  "type": "object",
  "properties": {
    "agentId": {
      "type": "string"
    },
    "agentEmail": {
      "type": "string",
      "format": "email"
    },
    "agentName": {
      "type": "string"
    },
    "orderId": {
      "type": "string"
    },
    "customerName": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "paid",
        "rejected"
      ],
      "default": "pending"
    }
  },
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.agentEmail": "{{user.email}}" },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "delete": { "user_condition": { "role": "super_admin" } }
  },
  "required": [
    "agentId",
    "orderId",
    "amount"
  ]
}
