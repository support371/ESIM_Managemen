{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "customer",
        "agent",
        "admin",
        "super_admin"
      ],
      "default": "customer"
    },
    "phone": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "suspended"
      ],
      "default": "active"
    },
    "company": {
      "type": "string"
    },
    "assignedAgentId": {
      "type": "string"
    }
  },
  "rls": {
    "create": true,
    "read": {
      "$or": [
        { "data.assignedAgentId": "{{user.id}}" },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "update": { "user_condition": { "role": "super_admin" } },
    "delete": { "user_condition": { "role": "super_admin" } }
  }
}
