{
  "name": "Order",
  "type": "object",
  "properties": {
    "orderNumber": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "userEmail": {
      "type": "string",
      "format": "email"
    },
    "userName": {
      "type": "string"
    },
    "planId": {
      "type": "string"
    },
    "planName": {
      "type": "string"
    },
    "esimId": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected",
        "assigned",
        "activated",
        "cancelled",
        "pending",
        "processing",
        "completed",
        "refunded"
      ],
      "default": "pending_review"
    },
    "paymentStatus": {
      "type": "string",
      "enum": [
        "not_required",
        "unpaid",
        "paid",
        "refunded",
        "failed"
      ],
      "default": "not_required"
    },
    "adminNote": {
      "type": "string",
      "description": "Admin note or reason for approval/rejection"
    }
  },
  "rls": {
    "create": { "user_condition": { "status": "active" } },
    "read": {
      "$or": [
        { "data.userEmail": "{{user.email}}" },
        { "data.userId": "{{user.id}}" },
        { "created_by": "{{user.email}}" },
        { "user_condition": { "role": "agent" } },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "delete": { "user_condition": { "role": "super_admin" } }
  },
  "required": [
    "orderNumber",
    "userId",
    "userEmail",
    "amount"
  ]
}
