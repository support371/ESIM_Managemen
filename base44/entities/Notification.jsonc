{
  "name": "Notification",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "userEmail": {
      "type": "string",
      "format": "email"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info"
    },
    "readStatus": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.userEmail": "{{user.email}}" },
        { "data.userId": "{{user.id}}" },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "update": {
      "$or": [
        { "data.userEmail": "{{user.email}}" },
        { "data.userId": "{{user.id}}" }
      ]
    },
    "delete": { "user_condition": { "role": "super_admin" } }
  },
  "required": [
    "userId",
    "title",
    "message"
  ]
}
