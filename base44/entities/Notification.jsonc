{
  "name": "Notification",
  "type": "object",
  "properties": {
    "userId": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "default": "info"
    },
    "readStatus": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "userId",
    "title",
    "message"
  ]
}