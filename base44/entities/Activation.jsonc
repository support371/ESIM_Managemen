{
  "name": "Activation",
  "type": "object",
  "properties": {
    "esimId": {
      "type": "string"
    },
    "esimIccid": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "userEmail": {
      "type": "string",
      "format": "email"
    },
    "userName": {
      "type": "string"
    },
    "planName": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "suspended",
        "expired",
        "deactivated"
      ],
      "default": "pending"
    },
    "activationCode": {
      "type": "string"
    },
    "qrCodeUrl": {
      "type": "string"
    },
    "activatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": "string"
    }
  },
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.userEmail": "{{user.email}}" },
        { "data.userId": "{{user.id}}" },
        { "user_condition": { "role": "agent" } },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "delete": { "user_condition": { "role": "super_admin" } }
  },
  "required": [
    "esimId",
    "userId",
    "userEmail"
  ]
}
