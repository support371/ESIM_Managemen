{
  "name": "Esim",
  "type": "object",
  "properties": {
    "iccid": {
      "type": "string",
      "description": "ICCID number"
    },
    "provider": {
      "type": "string",
      "description": "eSIM provider"
    },
    "planId": {
      "type": "string"
    },
    "planName": {
      "type": "string"
    },
    "qrCodeUrl": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            { "data.assignedUserEmail": "{{user.email}}" },
            { "data.assignedUserId": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "user_condition": { "role": "super_admin" } }
          ]
        },
        "write": {
          "$or": [
            { "user_condition": { "role": "admin" } },
            { "user_condition": { "role": "super_admin" } }
          ]
        }
      }
    },
    "activationCode": {
      "type": "string",
      "rls": {
        "read": {
          "$or": [
            { "data.assignedUserEmail": "{{user.email}}" },
            { "data.assignedUserId": "{{user.id}}" },
            { "user_condition": { "role": "admin" } },
            { "user_condition": { "role": "super_admin" } }
          ]
        },
        "write": {
          "$or": [
            { "user_condition": { "role": "admin" } },
            { "user_condition": { "role": "super_admin" } }
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "assigned",
        "activated",
        "expired",
        "disabled"
      ],
      "default": "available"
    },
    "assignedUserId": {
      "type": "string"
    },
    "assignedUserEmail": {
      "type": "string",
      "format": "email"
    },
    "assignedUserName": {
      "type": "string"
    },
    "assignedAt": {
      "type": "string",
      "format": "date-time"
    },
    "activatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.assignedUserEmail": "{{user.email}}" },
        { "data.assignedUserId": "{{user.id}}" },
        { "user_condition": { "role": "agent" } },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "delete": { "user_condition": { "role": "super_admin" } }
  },
  "required": [
    "iccid",
    "provider"
  ]
}
