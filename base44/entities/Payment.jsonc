{
  "name": "Payment",
  "type": "object",
  "properties": {
    "orderId": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "userEmail": {
      "type": "string",
      "format": "email"
    },
    "userName": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "paymentMethod": {
      "type": "string",
      "enum": [
        "credit_card",
        "debit_card",
        "paypal",
        "bank_transfer",
        "crypto",
        "other"
      ],
      "default": "credit_card"
    },
    "transactionReference": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "paidAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "read": {
      "$or": [
        { "data.userEmail": "{{user.email}}" },
        { "data.userId": "{{user.id}}" },
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "user_condition": { "role": "super_admin" } }
      ]
    },
    "delete": { "user_condition": { "role": "super_admin" } }
  },
  "required": [
    "orderId",
    "userId",
    "amount"
  ]
}
